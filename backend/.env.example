# This is a variable inventory. Spring Boot does not automatically read .env files.
# Set these in the IDE Run Configuration or the current shell process.
SPRING_PROFILES_ACTIVE=local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campus_perks_db
DB_USERNAME=
DB_PASSWORD=
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
API_DOCS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_ENABLED=false
JWT_SECRET_BASE64=
JWT_ISSUER=campus-perks
JWT_AUDIENCE=campus-web
# External adapters: credentials are never committed or included in frontend VITE_* values.
MINIO_ENABLED=false
MINIO_ENDPOINT=
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_REGION=us-east-1
MINIO_CONNECT_TIMEOUT=3s
MINIO_READ_TIMEOUT=10s
MINIO_WRITE_TIMEOUT=10s
MINIO_CALL_TIMEOUT=15s
AI_BASE_URL=
AI_API_KEY=
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=1024
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=campus-public-v1

# Stage 1: enable only with local/prod database, JWT and all three persistent secrets.
AUTH_ENABLED=false
OTP_HASH_SECRET_BASE64=
IDENTITY_KEY_BASE64=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
VERIFICATION_CODE_TTL=5m
SMS_RESEND_INTERVAL=60s
SMS_RATE_WINDOW=1h
SMS_PHONE_WINDOW_LIMIT=5
SMS_IP_WINDOW_LIMIT=20
SMS_MAX_CODE_ATTEMPTS=5
SMS_CODE_LENGTH=6
# Local-only simulation, explicit opt-in. To use a four-digit test code, also set SMS_CODE_LENGTH=4.
# Never enable with prod/production. Choose the test code through environment, not Java/Vue.
SMS_SIMULATED_ENABLED=false
SMS_SIMULATED_CODE=
PASSWORD_BCRYPT_STRENGTH=12
PASSWORD_MIN_LENGTH=10
PASSWORD_MAX_BYTES=72
PASSWORD_RATE_WINDOW=15m
PASSWORD_PHONE_LIMIT=10
PASSWORD_IP_LIMIT=60
USER_NICKNAME_PREFIX=校园用户
# Stage 2: business limits; storage adapter is still unavailable by default.
FILE_MAX_BYTES=10485760
FILE_MAX_PENDING_PER_USER=10
FILE_ALLOWED_TYPES=application/pdf,image/jpeg,image/png
FILE_UPLOAD_TTL=5m
FILE_DOWNLOAD_TTL=2m
FILE_OBJECT_PREFIX=private/merchant-qualifications
MERCHANT_CATEGORIES=DINING,ENTERTAINMENT,LIFE_SERVICE
MERCHANT_MAX_MEMBERS=20

# Stage 3: synchronous MySQL claims; Redis/RabbitMQ are not required or enabled.
COUPON_MAX_STOCK=100000
COUPON_MAX_VALIDITY=90d
# The existing unique constraint enforces 1; changing this requires a migration.
COUPON_CLAIM_LIMIT=1
REDEMPTION_TICKET_TTL=2m
REDEMPTION_TICKET_RESEND_INTERVAL=10s
REDEMPTION_RATE_WINDOW=1m
REDEMPTION_RATE_LIMIT=20
NOTIFICATION_DISPATCH_ENABLED=true
NOTIFICATION_POLL_INTERVAL_MS=2000
NOTIFICATION_BATCH_SIZE=10
NOTIFICATION_MAX_ATTEMPTS=8
NOTIFICATION_LEASE_TTL=1m
NOTIFICATION_RETRY_BASE=5s
NOTIFICATION_RETRY_MAX=5m
NOTIFICATION_AUTH_TIMEOUT=5s
NOTIFICATION_MAX_CONNECTIONS=1000
NOTIFICATION_MAX_CONNECTIONS_PER_USER=3
NOTIFICATION_MAX_MESSAGE_BYTES=4096
NOTIFICATION_SEND_TIME_LIMIT_MS=3000
NOTIFICATION_SEND_BUFFER_BYTES=65536
NOTIFICATION_PING_INTERVAL_SECONDS=20
NOTIFICATION_RECONNECT_DELAY_SECONDS=5

# Stage 4: only Alipay sandbox. Keep disabled until real sandbox credentials and HTTPS callback exist.
ALIPAY_SANDBOX_ENABLED=false
ALIPAY_SANDBOX_GATEWAY=https://openapi.alipaydev.com/gateway.do
ALIPAY_SANDBOX_APP_ID=
ALIPAY_SANDBOX_SELLER_ID=
ALIPAY_SANDBOX_PRIVATE_KEY=
ALIPAY_SANDBOX_PUBLIC_KEY=
ALIPAY_SANDBOX_NOTIFY_URL=
ALIPAY_SANDBOX_CONNECT_TIMEOUT=3s
ALIPAY_SANDBOX_READ_TIMEOUT=10s
ORDER_PAYMENT_TIMEOUT=15m
TRADE_SCHEDULER_ENABLED=true
TRADE_POLL_INTERVAL_MS=5000
TRADE_BATCH_SIZE=10
TRADE_MAX_STOCK=100000
TRADE_MAX_GROUP_SIZE=20
TRADE_MAX_GROUP_DURATION=1d
TRADE_MAX_OFFER_DURATION=90d
TRADE_REFUND_MAX_ATTEMPTS=8
TRADE_RETRY_BASE=10s
TRADE_RETRY_MAX=10m
TRADE_LEASE_TTL=2m
TRADE_PAYMENT_CHECK_INTERVAL=30s
TRADE_REDEMPTION_TTL=2m
TRADE_REDEMPTION_RESEND_INTERVAL=10s

# Stage 5: community/location/search; optional integrations remain disabled by default.
COMMUNITY_MAX_IMAGES=6
COMMUNITY_MAX_BODY_LENGTH=6000
COMMUNITY_MAX_COMMENT_LENGTH=2000
COMMUNITY_BLOCKED_TERMS=
LOCATION_MAX_RADIUS_METERS=20000
SEARCH_BACKEND=MYSQL
SEARCH_MAX_WINDOW=1000
SEARCH_EXCERPT_LENGTH=240
SEARCH_REBUILD_ENABLED=true
SEARCH_POLL_INTERVAL_MS=3000
SEARCH_BATCH_SIZE=10
SEARCH_LEASE_TTL=2m
# Only enable ELASTICSEARCH after manual provisioning; see docs/SEARCH-SETUP.md.
ELASTICSEARCH_ENDPOINT=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=campus-perks-search-v1
ELASTICSEARCH_EXPECTED_VERSION=
ELASTICSEARCH_IK_VERSION=
ELASTICSEARCH_TIMEOUT=5s

# Checklist repair: enable only with explicit private configuration. See docs/REPAIR-ACCEPTANCE.md.
SCHEDULER_POOL_SIZE=4
REDIS_ENABLED=false
REDIS_URI=
REDIS_TIMEOUT=5s
MONGO_ENABLED=false
MONGO_URI=
MONGO_DATABASE=campus_perks
MONGO_TIMEOUT=10s
RABBITMQ_ENABLED=false
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=campus
RABBITMQ_QUEUE=campus.events
RABBITMQ_TIMEOUT=5s
RABBITMQ_BATCH_SIZE=5
RABBITMQ_MAX_ATTEMPTS=8
RABBITMQ_MAX_QUEUE_LENGTH=10000
RABBITMQ_RETRY_DELAY=5s
ASSISTANT_ENABLED=false
ASSISTANT_HISTORY_TURNS=10
ASSISTANT_REQUESTS_PER_MINUTE=10
ASSISTANT_MAX_MESSAGE_LENGTH=2000
ASSISTANT_MAX_TOOL_ROUNDS=3
ASSISTANT_MAX_TOOL_CALLS=5
ASSISTANT_TOOL_TIMEOUT=10s
ASSISTANT_LEASE_TTL=5m
ASSISTANT_RETRIEVAL_LIMIT=5
ASSISTANT_MAX_CONTEXT_CHARS=6000
AI_ENABLED=false
# Stage 6: per-account UTC-day provider-call budgets (failed attempts count).
AI_DAILY_CHAT_CALLS=40
AI_DAILY_EMBEDDING_CALLS=60
MARKETING_AI_ENABLED=false
MARKETING_MAX_BRIEF_LENGTH=2000
MARKETING_MAX_TITLE_LENGTH=100
MARKETING_MAX_BODY_LENGTH=4000
MARKETING_REQUESTS_PER_MINUTE=3
MARKETING_MAX_ATTEMPTS=3
MARKETING_LEASE_TTL=2m
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_TIMEOUT=45s
AI_MAX_TOKENS=1500
AI_MAX_EMBEDDING_CHARS=6000
PINECONE_ENABLED=false
PINECONE_VECTOR_FIELD=embedding
PINECONE_TIMEOUT=15s
AMAP_ENABLED=false
AMAP_JS_KEY=
AMAP_SECURITY_CODE=
AMAP_TIMEOUT=10s
AMAP_REQUESTS_PER_MINUTE=120

# Stage 7: read-only analytics (no Redis dependency) and result-only operation auditing.
ANALYTICS_DEFAULT_DAYS=7
ANALYTICS_MAX_DAYS=93
ANALYTICS_DEFAULT_ZONE=Asia/Shanghai
ANALYTICS_ALLOWED_ZONES=Asia/Shanghai,UTC
ANALYTICS_CACHE_TTL=30s
ANALYTICS_MAX_CACHE_ENTRIES=128
ANALYTICS_TOP_COUPONS=10
OPERATION_AUDIT_ENABLED=true
OPERATION_AUDIT_DEFAULT_DAYS=7
OPERATION_AUDIT_MAX_DAYS=93

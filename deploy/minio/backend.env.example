# Application account only. Never use MINIO_ROOT_* in the business backend.
MINIO_ENABLED=true
# Local development reaches the cloud private listener through SSH forwarding.
MINIO_ENDPOINT=http://127.0.0.1:19000
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:19000
MINIO_ACCESS_KEY=replace-with-private-app-access-key
MINIO_SECRET_KEY=replace-with-private-app-secret-key
MINIO_BUCKET=campus-perks-files
MINIO_REGION=us-east-1
FILE_OBJECT_PREFIX=private/merchant-qualifications
FILE_MAX_BYTES=10485760
MINIO_CONNECT_TIMEOUT=3s
MINIO_READ_TIMEOUT=10s
MINIO_WRITE_TIMEOUT=10s
MINIO_CALL_TIMEOUT=15s

# Runtime and network settings are separate from Java/Vue source.
DEPLOY_ROOT=/opt/campus-perks-app
JAVA_HOME=/opt/campus-perks-app/runtime/java
APP_JAR=/opt/campus-perks-app/current/backend.jar
PUBLIC_HOST=replace-with-public-ip-or-domain
BACKEND_UPSTREAM=127.0.0.1:8080
MINIO_UPSTREAM=127.0.0.1:19000
MINIO_BUCKET=campus-perks-files
FRONTEND_ROOT=/opt/campus-perks-app/current/frontend
ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory
ACME_PROFILE=shortlived
XDG_DATA_HOME=/opt/campus-perks-app/data/web
XDG_CONFIG_HOME=/opt/campus-perks-app/data/web-config
JAVA_TOOL_OPTIONS=-Xms128m -Xmx512m -XX:MaxMetaspaceSize=192m -XX:MaxDirectMemorySize=96m -XX:ReservedCodeCacheSize=96m -XX:ActiveProcessorCount=2 -XX:+UseSerialGC

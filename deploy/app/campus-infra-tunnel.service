[Unit]
Description=Campus Perks private middleware forwards
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/opt/campus-perks-app/private/infra-tunnel.env
ExecStart=/opt/campus-perks-app/config/run-infra-tunnel.sh
Restart=always
RestartSec=5
MemoryLimit=64M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target

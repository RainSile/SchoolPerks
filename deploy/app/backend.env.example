# Inject privately. Spring Boot does not read this file automatically; systemd does.
SPRING_PROFILES_ACTIVE=local
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
SERVER_FORWARD_HEADERS_STRATEGY=native
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campus_perks_db
DB_USERNAME=replace-with-scoped-application-user
DB_PASSWORD=replace-with-random-private-password
DB_POOL_SIZE=3
AUTH_ENABLED=true
JWT_ENABLED=true
JWT_SECRET_BASE64=replace-with-persistent-private-key
OTP_HASH_SECRET_BASE64=replace-with-persistent-private-key
IDENTITY_KEY_BASE64=replace-with-persistent-private-key
API_DOCS_ENABLED=false
SMS_SIMULATED_ENABLED=false
ALIPAY_SANDBOX_ENABLED=false
ALIPAY_SANDBOX_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_SANDBOX_APP_ID=
ALIPAY_SANDBOX_SELLER_ID=
ALIPAY_SANDBOX_PRIVATE_KEY=
ALIPAY_SANDBOX_PUBLIC_KEY=
# The SDK otherwise logs complete signed requests at ERROR level.
LOGGING_LEVEL_SDK=OFF
# Notify URL and CORS derive from PUBLIC_HOST unless explicitly overridden.
REDIS_ENABLED=false
REDIS_URI=
MONGO_ENABLED=false
MONGO_URI=
MONGO_DATABASE=campus_perks
RABBITMQ_ENABLED=false
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=15673
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=campus
SEARCH_BACKEND=MYSQL
ELASTICSEARCH_ENDPOINT=
ELASTICSEARCH_API_KEY=
MINIO_ENABLED=false
MINIO_ENDPOINT=http://127.0.0.1:19000
MINIO_BUCKET=campus-perks-files
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
FILE_OBJECT_PREFIX=private/merchant-qualifications
AI_ENABLED=false
ASSISTANT_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_CHAT_MODEL=
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=1024
PINECONE_ENABLED=false
PINECONE_INDEX_HOST=
PINECONE_API_KEY=
PINECONE_NAMESPACE=
AMAP_ENABLED=false
AMAP_JS_KEY=
AMAP_SECURITY_CODE=
MARKETING_AI_ENABLED=false
NOTIFICATION_DISPATCH_ENABLED=false
SEARCH_REBUILD_ENABLED=false
TRADE_SCHEDULER_ENABLED=false

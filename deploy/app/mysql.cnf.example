[mysqld]
basedir=/opt/campus-perks-app/runtime/mysql
datadir=/opt/campus-perks-app/data/mysql
socket=/opt/campus-perks-app/data/mysql-run/mysql.sock
pid-file=/opt/campus-perks-app/data/mysql-run/mysql.pid
log-error=/opt/campus-perks-app/logs/mysql/error.log
bind-address=127.0.0.1
port=3306
mysqlx=0
skip-log-bin
skip-name-resolve
character-set-server=utf8mb4
collation-server=utf8mb4_0900_ai_ci
default-time-zone=+00:00
innodb-buffer-pool-size=192M
innodb-redo-log-capacity=64M
max-connections=25
table-open-cache=256
table-definition-cache=256
performance-schema=OFF
tmp-table-size=8M
max-heap-table-size=8M
max-allowed-packet=32M

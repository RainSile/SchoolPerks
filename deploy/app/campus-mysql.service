[Unit]
Description=Campus Perks private MySQL
After=network.target

[Service]
Type=simple
User=campus-mysql
Group=campus-mysql
ExecStart=/opt/campus-perks-app/runtime/mysql/bin/mysqld --defaults-file=/opt/campus-perks-app/config/mysql.cnf
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=120
MemoryLimit=512M
CPUQuota=75%
LimitNOFILE=8192
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWriteDirectories=/opt/campus-perks-app/data/mysql /opt/campus-perks-app/data/mysql-run /opt/campus-perks-app/logs/mysql

[Install]
WantedBy=multi-user.target

# Private SSH tunnel keeps middleware off the public internet.
INFRA_SSH_HOST=replace-with-infrastructure-server
INFRA_SSH_PORT=22
INFRA_SSH_USER=root
INFRA_SSH_KEY=/opt/campus-perks-app/private/infra_ed25519
INFRA_KNOWN_HOSTS=/opt/campus-perks-app/private/infra_known_hosts
REDIS_FORWARD_PORT=16379
REDIS_REMOTE_PORT=6379
MONGO_FORWARD_PORT=27018
MONGO_REMOTE_PORT=27017
RABBITMQ_FORWARD_PORT=15673
RABBITMQ_REMOTE_PORT=5672
ELASTICSEARCH_FORWARD_PORT=19200
ELASTICSEARCH_REMOTE_PORT=9200
MINIO_FORWARD_PORT=19000
MINIO_REMOTE_PORT=9000
